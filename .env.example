# Database Configuration
# Prefer URL-based configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5433/helpdesk_commander_dev
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/helpdesk_commander_test

# Optional: database names used when DATABASE_URL/TEST_DATABASE_URL are not set
DATABASE_NAME=helpdesk_commander_dev
TEST_DATABASE_NAME=helpdesk_commander_test

# PostgreSQL (used when DATABASE_URL/TEST_DATABASE_URL are not set)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Docker postgres host port (docker-compose only)
POSTGRES_HOST_PORT=5433

# Docker postgres default database (docker-compose only)
POSTGRES_DB=postgres

# Phoenix
SECRET_KEY_BASE=your_secret_key_base_here
PHX_HOST=localhost
PHX_PORT=4000

# Environment
MIX_ENV=dev

# PII protection (required in production)
# CLOAK_KEY: Base64 encoded 32-byte key used by Cloak (generate with:
#   :crypto.strong_rand_bytes(32) |> Base.encode64())
CLOAK_KEY=your_base64_32_byte_key_here
# PII_HMAC_SECRET: HMAC secret for email / company name lookup hashes
PII_HMAC_SECRET=your_pii_hmac_secret_here
# COMPANY_CODE_HMAC_SECRET: HMAC secret for company code hashes
COMPANY_CODE_HMAC_SECRET=your_company_code_hmac_secret_here
